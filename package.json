{
  "name": "logtohub",
  "version": "0.2.7",
  "description": "Hub de logging multi-plataforma com suporte a Discord, Telegram, Slack e outros",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest"
  },
  "keywords": [
    "logging",
    "discord",
    "telegram",
    "slack",
    "notification",
    "alerts",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@slack/web-api": "^8.5.0",
    "discord.js": "^14.23.2",
    "grammy": "^1.38.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core$": "<rootDir>/src/AbstractLogger.ts",
      "^@domain/(.*)\\.js$": "<rootDir>/src/types/$1",
      "^@utils/(.*)\\.js$": "<rootDir>/src/utils/$1",
      "^@channels/(.*)\\.js$": "<rootDir>/src/channels/$1",
      "^@discord/(.*)\\.js$": "<rootDir>/src/discord/$1",
      "^@telegram/(.*)\\.js$": "<rootDir>/src/telegram/$1",
      "^@platform-slack/(.*)\\.js$": "<rootDir>/src/slack/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
